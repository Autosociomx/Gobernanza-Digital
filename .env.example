# .env.example
# Google Maps Platform
GOOGLE_MAPS_PLATFORM_KEY=

# Gemini AI
GEMINI_API_KEY=
STRIPE_SECRET_KEY=
VITE_STRIPE_PUBLIC_KEY=
GOOGLE_MAPS_API_KEY=

# Context.OS Runtime LAB — apagado por defecto
VITE_CONTEXTOS_BRIDGE_ENABLED=false
VITE_CONTEXTOS_RUNTIME_URL=http://127.0.0.1:3011
CONTEXTOS_HOST=127.0.0.1
CONTEXTOS_PORT=3011
CONTEXTOS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Conectores institucionales (conectores/) — apagados por defecto.
# En true sin implementación real registrada responden NO_CONFIGURADO (no caen al mock).
CONECTOR_RENAPO_ENABLED=false
CONECTOR_CATASTRO_ENABLED=false
CONECTOR_SIAPA_ENABLED=false
CONECTOR_SAT_ENABLED=false
CONECTOR_FIRMA_ENABLED=false
